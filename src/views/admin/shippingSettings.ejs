<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h2 class="mb-1">Configuracion de envios</h2>
    <small class="text-muted">
      Define solo las ciudades que realmente atiende <strong><%= selectedStore.name %></strong>.
    </small>
  </div>
</div>

<% if (flash) { %>
  <div class="alert alert-<%= flash.type === 'success' ? 'success' : 'danger' %>">
    <%= flash.message %>
  </div>
<% } %>

<% if (errorMessages && errorMessages.length > 0) { %>
  <div class="alert alert-danger">
    <ul class="mb-0">
      <% errorMessages.forEach(message => { %>
        <li><%= message %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<% if (adminSession?.role === "superadmin") { %>
  <div class="bg-white shadow rounded p-3 mb-4">
    <form method="GET" action="/admin/shipping-settings" class="row g-3 align-items-end">
      <div class="col-md-4">
        <label class="form-label">Tienda</label>
        <select name="storeId" class="form-select" onchange="this.form.submit()">
          <% stores.forEach(store => { %>
            <option value="<%= store.id %>" <%= Number(selectedStore.id) === Number(store.id) ? "selected" : "" %>>
              <%= store.name %> (<%= store.slug %>)
            </option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-4">
        <small class="text-muted d-block">URL publica</small>
        <a href="/s/<%= selectedStore.slug %>" target="_blank">/s/<%= selectedStore.slug %></a>
      </div>
    </form>
  </div>
<% } %>

<form method="POST" action="/admin/shipping-settings" class="bg-white shadow rounded p-4">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="storeId" value="<%= selectedStore.id %>">

  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="mb-1">Ciudades atendidas</h5>
      <small class="text-muted">Activa solo las ciudades que aceptas por ahora. Puedes agregar otras manualmente.</small>
    </div>
    <button type="button" class="btn btn-outline-primary btn-sm" onclick="addCityRow()">
      Agregar ciudad
    </button>
  </div>

  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Ciudad</th>
          <th>Activa</th>
          <th>Cobrar envio</th>
          <th>Costo</th>
          <th>Contraentrega</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="shippingCityRows">
        <% shippingCities.forEach((city, index) => { %>
          <tr>
            <td style="min-width: 220px;">
              <input type="hidden" name="cities[<%= index %>][key]" value="<%= city.key %>">
              <input type="text" name="cities[<%= index %>][label]" class="form-control" value="<%= city.label %>" placeholder="Ej: Cali">
            </td>
            <td>
              <div class="form-check form-switch">
                <input
                  class="form-check-input city-active-toggle"
                  type="checkbox"
                  name="cities[<%= index %>][isActive]"
                  value="1"
                  data-row-index="<%= index %>"
                  <%= city.isActive !== false ? "checked" : "" %>
                >
              </div>
            </td>
            <td>
              <div class="form-check form-switch">
                <input
                  class="form-check-input city-charge-toggle"
                  type="checkbox"
                  name="cities[<%= index %>][chargeShipping]"
                  value="1"
                  data-cost-input="city-cost-<%= index %>"
                  <%= city.chargeShipping ? "checked" : "" %>
                >
              </div>
            </td>
            <td style="max-width: 180px;">
              <input
                type="number"
                min="0"
                step="100"
                class="form-control"
                id="city-cost-<%= index %>"
                name="cities[<%= index %>][cost]"
                value="<%= Number(city.cost || 0) %>"
                <%= city.chargeShipping ? "" : "disabled" %>
              >
            </td>
            <td>
              <div class="form-check form-switch">
                <input
                  class="form-check-input"
                  type="checkbox"
                  name="cities[<%= index %>][allowCashOnDelivery]"
                  value="1"
                  <%= city.allowCashOnDelivery ? "checked" : "" %>
                >
              </div>
            </td>
            <td class="text-end">
              <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCityRow(this)">
                Quitar
              </button>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="d-flex justify-content-between align-items-center mt-3">
    <small class="text-muted">
      Si una ciudad esta inactiva, no aparecera en checkout. Si el cobro de envio esta apagado, se mostrara como gratis.
    </small>
    <button class="btn btn-success" type="submit">Guardar configuracion</button>
  </div>
</form>

<template id="shippingCityRowTemplate">
  <tr>
    <td style="min-width: 220px;">
      <input type="hidden" data-field="key" value="">
      <input type="text" data-field="label" class="form-control" placeholder="Ej: Cali">
    </td>
    <td>
      <div class="form-check form-switch">
        <input class="form-check-input city-active-toggle" type="checkbox" data-field="isActive" value="1" checked>
      </div>
    </td>
    <td>
      <div class="form-check form-switch">
        <input class="form-check-input city-charge-toggle" type="checkbox" data-field="chargeShipping" value="1" checked>
      </div>
    </td>
    <td style="max-width: 180px;">
      <input type="number" min="0" step="100" class="form-control city-cost-input" data-field="cost" value="12000">
    </td>
    <td>
      <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" data-field="allowCashOnDelivery" value="1">
      </div>
    </td>
    <td class="text-end">
      <button type="button" class="btn btn-outline-danger btn-sm" onclick="removeCityRow(this)">
        Quitar
      </button>
    </td>
  </tr>
</template>

<script>
  function bindChargeToggle(toggle) {
    const targetId = toggle.dataset.costInput;
    const target = targetId ? document.getElementById(targetId) : toggle.closest("tr")?.querySelector(".city-cost-input");

    const sync = () => {
      if (!target) return;
      target.disabled = !toggle.checked;
      if (!toggle.checked) {
        target.value = 0;
      }
    };

    toggle.addEventListener("change", sync);
    sync();
  }

  document.querySelectorAll(".city-charge-toggle").forEach(bindChargeToggle);

  function addCityRow() {
    const template = document.getElementById("shippingCityRowTemplate");
    const container = document.getElementById("shippingCityRows");
    const fragment = template.content.cloneNode(true);
    const nextIndex = container.children.length;
    const toggle = fragment.querySelector(".city-charge-toggle");
    const costInput = fragment.querySelector(".city-cost-input");

    if (toggle && costInput) {
      const inputId = `city-cost-new-${nextIndex}`;
      costInput.id = inputId;
      toggle.dataset.costInput = inputId;
    }

    fragment.querySelectorAll("[data-field]").forEach((field) => {
      field.name = `cities[${nextIndex}][${field.dataset.field}]`;
    });

    container.appendChild(fragment);
    const appendedRow = container.lastElementChild;
    appendedRow?.querySelectorAll(".city-charge-toggle").forEach(bindChargeToggle);
  }

  function removeCityRow(button) {
    const row = button.closest("tr");
    if (row) {
      row.remove();
    }
  }
</script>
